# Optional: the campus demo and device voices work without keys.
# Server only. Enable Routes API and restrict this key to that API.
GOOGLE_MAPS_API_KEY=
# Public browser key: enable Maps JavaScript API and restrict HTTP referrers.
GOOGLE_MAPS_BROWSER_KEY=
# Custom narration, server only.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
# Built-in or custom voices from your ElevenLabs account, server only.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
PORT=3001
HOST=127.0.0.1
# Comma-separated origins, only if hosting behind your own authenticated proxy.
ALLOWED_ORIGIN=
